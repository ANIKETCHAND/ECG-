# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv/
venv/
env/

# IDEs & OS
.idea/
.vscode/
*.swp
.DS_Store

# Temporary files & tests
*.log
.pytest_cache/
.freebuff/

# Raw large dataset files (can be downloaded via python training/prepare_dataset.py)
data/raw/*.dat
data/raw/*.hea
data/raw/*.atr
!data/raw/.gitkeep

# Processed large CSVs (generated via train_test_split.py)
data/processed/*.csv
!data/processed/.gitkeep
!data/processed/split_info.json
!data/processed/dataset_info.json

# Runtime clinical databases & audit trails
data/*.db
data/*.db-journal
data/*.jsonl
.vercel

# Dataset raw downloads
data/datasets/**/raw/*
data/datasets/**/processed/*
!data/datasets/**/.gitkeep

# Generated download manifest (write-only provenance; embeds a machine-local absolute path)
data/datasets/**/metadata/*.json

.vercel
reports/MRN-*/
reports/PAT-*/
