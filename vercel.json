{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "src/**,models/classifier.pkl,models/scaler.pkl,models/metadata.json,models/production/classifier.pkl,models/production/scaler.pkl"
    }
  }
}

