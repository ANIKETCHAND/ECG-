[TEMPLATE]
# ECG GUARDIAN — ENVIRONMENT CONFIGURATION TEMPLATE
# Regulatory Standard: CDSCO MDR 2017 & IEC 62304 / ISO 13485
# Rule: Never commit real secrets or production service_role keys to git.

# ─────────────────────────────────────────
# ENVIRONMENT SEPARATION: development | staging | production
# ─────────────────────────────────────────
ENVIRONMENT="development"
APP_NAME="ECG Guardian"
FACILITY_ID="MED-FAC-2026-IND"
HOSPITAL_NAME="Apex Heart & Vascular Hospital"
DEPARTMENT="Department of Cardiac Electrophysiology & Telemetry"

# ─────────────────────────────────────────
# SERVER & NETWORK
# ─────────────────────────────────────────
PORT=8000
HOST="0.0.0.0"
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"
STREAMLIT_SERVER_HEADLESS=true

# ─────────────────────────────────────────
# PERSISTENCE & STORAGE (Local Fallback & Dual-Storage)
# ─────────────────────────────────────────
DATABASE_PATH="data/hospital_clinical.db"
AUDIT_TRAIL_PATH="data/audit_trail.db"
AUDIT_JSONL_PATH="data/audit_trail.jsonl"
REPORTS_OUTPUT_DIR="reports"

# ─────────────────────────────────────────
# SUPABASE CONFIGURATION (Cloud Persistence & Bucket)
# NOTE: Frontend must ONLY ever use SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_SERVICE_ROLE_KEY is restricted to backend secure services only.
# ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="ecg-reports"

# ─────────────────────────────────────────
# CLINICAL DECISION SUPPORT & GOVERNANCE
# ─────────────────────────────────────────
DATA_PRIVACY_LEVEL="STRICT_CDSCO_MDR_2017"
SESSION_DURATION_SECONDS=3600
ENABLE_MANDATORY_CLINICIAN_REVIEW=true
MODEL_REGISTRY_PATH="models/registry"
ACTIVE_PRODUCTION_MODEL="ECG-RF-1.0.0"

# ─────────────────────────────────────────
# API SECURITY (serverless / FastAPI surface)
# Read by api/security.py. Values are read per request, so changes take effect
# without a restart.
# ─────────────────────────────────────────
# Shared key required as the X-API-Key header on data-bearing endpoints.
# LEAVE EMPTY IN DEVELOPMENT: /api/health then reports auth: DISABLED, so an
# unauthenticated deployment is visible rather than silently assumed safe.
ECG_API_KEY=
# Comma-separated CORS allow-list. Empty means same-origin only. Use "*" only as
# a deliberate decision — it exposes clinical endpoints to any origin.
ECG_CORS_ORIGINS=
# Request body ceiling (MB) and maximum accepted ECG sample count per analysis.
ECG_MAX_UPLOAD_MB=25
ECG_MAX_SIGNAL_SAMPLES=5000000

# ─────────────────────────────────────────
# TRAINING DATA INTEGRITY
# ECG_ALLOW_PLACEHOLDER_TRAINING=1 permits training on fabricated samples, purely
# to exercise application plumbing. Such artifacts are stamped
# SYNTHETIC_PLACEHOLDER in the model registry and can never be served as the
# production model. Never set this for a model you intend to report on or deploy.
# ─────────────────────────────────────────
ECG_ALLOW_PLACEHOLDER_TRAINING=
